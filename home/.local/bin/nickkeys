#!/usr/bin/env python3
"""nickkeys — searchable list of every global shortcut configured in KDE.

Reads ~/.config/kglobalshortcutsrc and pipes it into fzf (falls back to less).
  nickkeys            interactive search
  nickkeys --gui      floating search popup (bound to Meta+/)
  nickkeys --print    plain list (pipe it, grep it)
"""
import json
import os
import re
import shutil
import subprocess
import sys

RC = os.path.expanduser("~/.config/kglobalshortcutsrc")
FAVS = os.path.expanduser("~/.config/nicklab/nickkeys-favorites.json")

# Component group names -> friendlier labels
LABELS = {"kwin": "Windows", "plasmashell": "Plasma", "ksmserver": "Session",
          "kaccess": "Accessibility", "mediacontrol": "Media",
          "org_kde_powerdevil": "Power", "kmix": "Volume"}


def unescape(s):
    # KConfig level: \t = separator between alternative keys, \\ = backslash
    s = s.replace("\\t", "\t").replace("\\\\", "\\")
    # kglobalaccel level: \, = comma, \\ = backslash
    return re.sub(r"\\(.)", r"\1", s)


def app_name(desktop_id):
    """Human name of a launcher from its .desktop file (falls back to the id)."""
    for d in (os.path.expanduser("~/.local/share/applications"), "/usr/share/applications",
              "/usr/share/kglobalaccel"):
        try:
            with open(os.path.join(d, desktop_id), encoding="utf-8") as f:
                for line in f:
                    if line.startswith("Name="):
                        return line.split("=", 1)[1].strip()
        except OSError:
            continue
    return desktop_id.removesuffix(".desktop")


def parse():
    rows, group, friendly = [], None, {}
    with open(RC, encoding="utf-8") as f:
        for line in f:
            line = line.rstrip("\n")
            if line.startswith("["):
                group = re.findall(r"\[([^\]]*)\]", line)[-1]
                continue
            if not group or "=" not in line:
                continue
            name, value = line.split("=", 1)
            if name == "_k_friendly_name":
                friendly[group] = value
                continue
            parts = value.rsplit(",", 2)
            if len(parts) == 3:
                active, _default, desc = parts
            elif group.endswith(".desktop"):  # [services] entries store only the keys
                active, desc = value, ""
            else:
                continue
            keys = [k for k in unescape(active).split("\t") if k and k != "none"]
            if not keys:
                continue
            if name == "_launch":  # app/service launchers ([services][foo.desktop])
                desc = "Launch " + app_name(group)
            rows.append((keys, desc or name, group, f"{group}/{name}"))
    out = []
    for keys, desc, group, sid in rows:
        comp = "Launchers" if group.endswith(".desktop") else (LABELS.get(group) or friendly.get(group) or group)
        if desc.startswith("Krohnkite: "):
            comp, desc = "Tiling", desc.removeprefix("Krohnkite: ")
        out.append((" / ".join(keys), desc, comp, sid))
    # Favorites first, then Meta shortcuts, then the rest, alphabetically by key
    favs = load_favs()
    out.sort(key=lambda r: (r[3] not in favs, not r[0].startswith("Meta"), r[0].lower()))
    return out, favs


def load_favs():
    try:
        with open(FAVS, encoding="utf-8") as f:
            return list(json.load(f))
    except (OSError, ValueError):
        return []


def main():
    rows, favs = parse()
    if "--gui" in sys.argv:
        os.makedirs(os.path.dirname(FAVS), exist_ok=True)
        data = json.dumps({"favPath": FAVS, "favs": favs,
                           "rows": [{"keys": k, "action": d, "group": c, "id": i} for k, d, c, i in rows]})
        qml = os.path.expanduser("~/.local/share/nicklab/nickkeys.qml")
        # QML saves favorites with XMLHttpRequest PUT to a file:// URL
        os.environ["QML_XHR_ALLOW_FILE_READ"] = "1"
        os.environ["QML_XHR_ALLOW_FILE_WRITE"] = "1"
        os.execvp("qml6", ["qml6", "-a", "gui", qml, "--", data])
    w = max(len(r[0]) for r in rows) + 2
    lines = [f"{'★' if i in favs else ' '} {k:<{w}}{d:<45}{c}" for k, d, c, i in rows]
    text = "\n".join(lines) + "\n"
    if "--print" in sys.argv or not sys.stdout.isatty():
        sys.stdout.write(text)
        return
    if shutil.which("fzf"):
        subprocess.run(["fzf", "--layout=reverse", "--no-sort", "--exact", "-i",
                        "--prompt=keys> ", "--pointer=▌", "--no-info",
                        f"--header=  {'KEYS':<{w}}{'ACTION':<45}GROUP   (type to filter · Esc to close)",
                        "--color=bg+:#0C322C,fg+:#E6F1EC,hl:#3DFF9A,hl+:#3DFF9A,"
                        "prompt:#2E6BFF,pointer:#3DFF9A,header:#FFD23F,border:#2E6BFF"],
                       input=text, text=True)
    else:
        subprocess.run(["less", "-S", "-i"], input=text, text=True)


if __name__ == "__main__":
    main()
