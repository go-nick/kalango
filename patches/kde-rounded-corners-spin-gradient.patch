 namespace
 {
+    // NickLab patch: extra angle for the spinning gradient on the active window
+    float spinAngle(const ShapeCorners::Window &window)
+    {
+        const double period = ShapeCorners::Config::outlineSpinSeconds();
+        if (period <= 0 || window.w != KWin::effects->activeWindow()) {
+            return 0.F;
+        }
+        static const auto start = std::chrono::steady_clock::now();
+        const double secs = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+        return static_cast<float>(std::fmod(secs / period, 1.0) * 360.0);
+    }
